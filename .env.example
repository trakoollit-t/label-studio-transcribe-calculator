# Copy to .env (it is gitignored) and fill in.
# Self-hosted:        http://localhost:8080
# HumanSignal cloud:  https://app.humansignal.com
LABEL_STUDIO_URL=https://app.humansignal.com

# Account & Settings -> Personal Access Token
LABEL_STUDIO_TOKEN=

# Optional: task.data key holding each file's audio duration in seconds.
# Only needed for whole-file transcription projects where auto-detection misses it.
#LABEL_STUDIO_DURATION_FIELD=duration

# Set to 1 to skip TLS certificate verification (server with an expired or
# mismatched cert). Only do this for a host you trust on a network you trust:
# your token is sent over a connection that cannot be authenticated.
#LABEL_STUDIO_INSECURE=1
